{
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": ["{{MCP}}"],
    "allow": ["Bash", "PowerShell", "Edit", "Write", "NotebookEdit", "Read", "Glob", "Grep", "WebFetch", "WebSearch", "mcp__aio-hub"],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "{{MCP}}/runtime/node/node.exe {{MCP}}/protocol/hub/guard.mjs --for claude", "timeout": 15 }
        ]
      }
    ]
  }
}